{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Unthred/ha-engineering-handbook/schemas/ai-handover.schema.json",
  "title": "AI campaign handover latest pointer (protocol version 1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "handover_id",
    "project",
    "repository",
    "created_utc",
    "source_branch",
    "source_commit",
    "pointer_branch",
    "report_path",
    "report_sha256",
    "github_url",
    "states",
    "recommended_next_overseer_action"
  ],
  "properties": {
    "protocol_version": { "const": 1 },
    "handover_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9][a-z0-9-]{1,80}$"
    },
    "project": {
      "type": "string",
      "description": "Stable project key: home-assistant, squigos, unraid, firewall, handbook."
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "created_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "source_branch": { "type": "string", "minLength": 1 },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "pointer_branch": { "type": "string", "minLength": 1 },
    "pointer_commit": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$"
    },
    "issues": {
      "type": "array",
      "items": { "type": "string" }
    },
    "pull_requests": {
      "type": "array",
      "items": { "type": "string" }
    },
    "objective": { "type": "string" },
    "outcome": { "type": "string" },
    "states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["development", "review", "deployment", "merge"],
      "properties": {
        "development": {
          "type": "string",
          "enum": ["not_started", "in_progress", "complete", "blocked"]
        },
        "review": {
          "type": "string",
          "enum": ["not_started", "pass", "pass_with_nits", "fail", "blocked"]
        },
        "deployment": {
          "type": "string",
          "enum": [
            "not_applicable",
            "not_started",
            "candidate_deployed",
            "rolled_back",
            "blocked"
          ]
        },
        "merge": {
          "type": "string",
          "enum": ["unmerged", "merged_develop", "merged_main", "not_applicable"]
        }
      }
    },
    "report_path": {
      "type": "string",
      "pattern": "^docs/ai/handovers/.+\\.md$"
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "github_url": { "type": "string", "minLength": 8 },
    "raw_url": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "note"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": ["string", "null"] },
          "note": { "type": "string" }
        }
      }
    },
    "tests": { "type": "string" },
    "independent_review": { "type": "string" },
    "production": { "type": "string" },
    "risks": { "type": "string" },
    "human_acceptance": { "type": "string" },
    "recommended_next_overseer_action": { "type": "string", "minLength": 1 }
  }
}
